<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <!-- The version this component reports, and the single source of truth for it. release-please
             rewrites this line and finds it by the trailing marker comment, so both must stay together
             on one line. The Dockerfile passes `-p:Version=` only when CI gives it one, so an ordinary
             `docker build` inherits this value rather than a placeholder. -->
        <VersionPrefix>1.0.0</VersionPrefix> <!-- x-release-please-version -->

        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>

        <!-- TargetFramework, Nullable, ImplicitUsings and LangVersion come from
             ../Directory.Build.props, shared with the test project. -->

        <!-- Warnings were previously invisible: five real nullability issues sat in the build output
             unnoticed because nothing failed on them. -->
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

        <!-- Deliberately NOT latest-recommended. That set is almost entirely CA1848
             (LoggerMessage delegates) plus rules that contradict this project's own conventions:
             CA1725 wants the documented `ct` parameter renamed to `stoppingToken`, CA1711 objects
             to a queue type being named Queue, and CA1716 objects to the Shared namespace. None of
             those are defects, and failing the build on them would bury the warnings that matter. -->
        <AnalysisLevel>latest</AnalysisLevel>

        <!-- The OpenAPI document is the contract with the Android app, which can no longer compile against
             these DTOs. It is generated into docs/openapi on request (`-p:GenerateOpenApi=true`) rather than
             on every build, so an ordinary build neither runs the host nor rewrites a tracked file. -->
        <OpenApiGenerateDocuments>false</OpenApiGenerateDocuments>
        <OpenApiGenerateDocuments Condition="'$(GenerateOpenApi)' == 'true'">true</OpenApiGenerateDocuments>
        <OpenApiDocumentsDirectory>$(MSBuildThisFileDirectory)..\..\docs\openapi</OpenApiDocumentsDirectory>
        <OpenApiGenerateDocumentsOptions>--file-name kvitteria</OpenApiGenerateDocumentsOptions>
    </PropertyGroup>

    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="MailKit" />
      <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
      <!-- The Data Protection key ring lives in Postgres, so KvitteriaDbContext can be its store. -->
      <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" />
      <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
      <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <!-- Explicit, and not private: the code uses EF Core directly, and referencing it only through
           Design meant the version never flowed to referencing projects. -->
      <PackageReference Include="Microsoft.EntityFrameworkCore" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
      <PackageReference Include="Scalar.AspNetCore" />
    </ItemGroup>


</Project>
