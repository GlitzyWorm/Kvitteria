<!-- Everything from the design system that is not a colour: type, the density scale, radii and
     elevation. Kept apart from Colors.xaml because the colour ramps are generated values with a
     conversion behind them, while these are literals copied straight across.

     The source's px values are used as-is. MAUI units are device-independent pixels, which match CSS
     px closely enough that rescaling would only make this file disagree with the reference — and the
     scale is already the compact 0.70× one, so it needs no further tightening for a phone. The
     headline sizes (42/32) are genuinely large on a narrow screen; that is the system's own rhythm,
     and a page should reach for a smaller step rather than redefining the step. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ══ Type ══
         Aliases, not file names: the mapping to a .ttf lives in MauiProgram.ConfigureFonts, which is
         the only place a font file is named. Montserrat carries headings, Poppins body — taken from
         the source's font-heading / font-body tokens, which its own prose contradicts in two
         places. Heading weight is capped at 500 (Montserrat Medium): hierarchy comes from size and
         space, so there is deliberately no bold heading face registered to reach for. -->
    <x:String x:Key="FontHeading">KvitteriaHeading</x:String>
    <x:String x:Key="FontBody">KvitteriaBody</x:String>
    <x:String x:Key="FontBodyMedium">KvitteriaBodyMedium</x:String>

    <!-- The bundled Phosphor face, which the product mockup draws every icon from (ph ph-receipt and
         friends). An icon is a glyph here, not an image: one file scales to every density, takes the
         TextColor of whatever it sits in, and needs no per-icon asset. Code points are named in
         Features/Shared/PhosphorIcons.cs — XAML never spells a private-use character out. -->
    <x:String x:Key="FontIcons">KvitteriaIcons</x:String>

    <x:Double x:Key="FontSizeH1">42</x:Double>
    <x:Double x:Key="FontSizeH2">32</x:Double>
    <x:Double x:Key="FontSizeH3">25</x:Double>
    <x:Double x:Key="FontSizeH4">20</x:Double>
    <x:Double x:Key="FontSizeH5">16</x:Double>
    <x:Double x:Key="FontSizeH6">13</x:Double>
    <x:Double x:Key="FontSizeBody">15</x:Double>
    <x:Double x:Key="FontSizeControl">14</x:Double>
    <x:Double x:Key="FontSizeSmall">13</x:Double>
    <x:Double x:Key="FontSizeMeta">11</x:Double>
    <x:Double x:Key="FontSizeLabel">12</x:Double>

    <!-- Icon steps, from the mockup's inline font-size on each <i>: 15px for the brand mark, 17px
         for a control glyph, 16px for a nav item. -->
    <x:Double x:Key="FontSizeIconSm">15</x:Double>
    <x:Double x:Key="FontSizeIcon">17</x:Double>

    <!-- Headings run tight (line-height 1.12, letter-spacing -0.015em); body is airy at 1.55. -->
    <x:Double x:Key="LineHeightHeading">1.12</x:Double>
    <x:Double x:Key="LineHeightBody">1.55</x:Double>

    <!-- ══ Density scale, 0.70× ══
         Fractional on purpose — these are the source's own values, not roundings of an 4/8pt grid.
         Rounding them here would drift every layout away from the reference by a pixel at a time. -->
    <x:Double x:Key="Space1">2.8</x:Double>
    <x:Double x:Key="Space2">5.6</x:Double>
    <x:Double x:Key="Space3">8.4</x:Double>
    <x:Double x:Key="Space4">11.2</x:Double>
    <x:Double x:Key="Space6">16.8</x:Double>
    <x:Double x:Key="Space8">22.4</x:Double>

    <!-- Padding shorthands, for the places a Thickness is wanted rather than a Spacing. -->
    <Thickness x:Key="PaddingCard">11.2</Thickness>
    <Thickness x:Key="PaddingPanel">22.4</Thickness>
    <Thickness x:Key="PaddingButton">10.08,5.6</Thickness>
    <!-- space-2 vertical, space-3 * 1.2 horizontal -->
    <Thickness x:Key="PaddingTag">10,3</Thickness>
    <Thickness x:Key="PaddingInput">10,6</Thickness>
    <Thickness x:Key="PaddingNavItem">10,8</Thickness>
    <!-- The mockup's mobile hero padding; it drops to 20/18 from the desktop 30/32. -->
    <Thickness x:Key="PaddingHero">18,20</Thickness>

    <!-- ══ Radius ══ -->
    <x:Single x:Key="RadiusSmValue">4</x:Single>
    <x:Single x:Key="RadiusMdValue">8</x:Single>
    <x:Single x:Key="RadiusLgValue">14</x:Single>
    <CornerRadius x:Key="RadiusSm">4</CornerRadius>
    <CornerRadius x:Key="RadiusMd">8</CornerRadius>
    <CornerRadius x:Key="RadiusLg">14</CornerRadius>
    <!-- .tag uses radius-md * 0.75 -->
    <CornerRadius x:Key="RadiusTag">6</CornerRadius>

    <!-- ══ Elevation ══
         On a dark ground elevation is a hairline edge plus ambient darkness, never a stacked drop
         shadow. The edge is the *border* half of each shadow token and belongs on the Border that
         carries it (Neutral800 at sm, Neutral700 at md, Neutral500 at lg); what is left for a real
         MAUI Shadow is only the ambient fall, which sm does not have at all — so ElevationSm is
         deliberately absent rather than defined as a no-op. -->
    <Shadow x:Key="ElevationMd" Brush="Black" Offset="0,6" Radius="18" Opacity="0.55" />
    <Shadow x:Key="ElevationLg" Brush="Black" Offset="0,16" Radius="40" Opacity="0.65" />

    <!-- ══ The hero wash ══
         The overview hero in the mockup is a radial accent bloom off the top-left corner, laid over
         the surface colour: `radial-gradient(120% 160% at 0% 0%, accent 16%, transparent 62%)`.

         Two things do not survive the translation exactly. MAUI's RadialGradientBrush has a single
         scalar Radius, so the source's 120%/160% ellipse becomes a circle — 1.4 splits the difference
         and reads the same at card proportions. And a MAUI Brush is one layer, not a stack, so the
         surface colour underneath it is the Border's own BackgroundColor rather than a second layer
         in the brush.

         Both stops are the accent, one at 16% alpha and one at 0 — see AccentFade in Colors.xaml for
         why the far stop is not simply Transparent. -->
    <RadialGradientBrush x:Key="HeroWash" Center="0,0" Radius="1.4">
        <GradientStop Color="{StaticResource AccentTint16}" Offset="0" />
        <GradientStop Color="{StaticResource AccentFade}" Offset="0.62" />
    </RadialGradientBrush>

    <!-- The blob bleeding in from the top-right corner: a circle whose fill fades out at 70% of its
         own radius, so it never shows an edge. It is a separate layer because it sits outside the
         card and is clipped by it, which one brush cannot express. -->
    <RadialGradientBrush x:Key="HeroCornerGlow" Center="0.5,0.5" Radius="0.5">
        <GradientStop Color="{StaticResource AccentTint22}" Offset="0" />
        <GradientStop Color="{StaticResource AccentFade}" Offset="0.7" />
    </RadialGradientBrush>

    <!-- text-shadow: 0 0 46px accent 34% — the bloom under the hero amount. Unlike the elevation
         shadows this one is coloured and has no offset: it is light coming off the figure, not the
         figure casting onto something. -->
    <Shadow x:Key="HeroTextGlow" Brush="{StaticResource AccentBrush}" Offset="0,0" Radius="46" Opacity="0.34" />

    <!-- The accent glow behind the wordmark, the one place the accent is allowed to bloom. -->
    <Shadow x:Key="AccentGlow" Brush="{StaticResource AccentBrush}" Offset="0,0" Radius="18" Opacity="0.22" />

    <!-- ══ Strokes ══ -->
    <x:Double x:Key="StrokeHairline">1</x:Double>
    <x:Double x:Key="StrokeControl">1.5</x:Double>
</ResourceDictionary>
