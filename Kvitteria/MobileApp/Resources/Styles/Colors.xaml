<!-- The Kvitteria palette, from kvitteria-design-system.html. The source declares every value in
     oklch, which XAML cannot parse, so each is converted to sRGB hex and the original is kept in the
     comment beside it — that comment is the authority when a value is ever retuned. Conversion is
     the standard OKLab → linear sRGB matrix with gamut clipping; a handful of the accent steps sit
     slightly outside sRGB and are clipped, which is what a browser does too.

     This is a dark-only system: there is no light ramp to bind against, so nothing here uses
     AppThemeBinding and App.xaml.cs pins UserAppTheme to Dark. A light theme would need its own set
     of tokens designed, not derived. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ══ Ground ══ -->
    <Color x:Key="Bg">#0B1914</Color>
    <!-- oklch(0.198 0.022 170) -->
    <!-- The dialog backdrop: the page ground at 70%. The source's .dialog-backdrop is the one
         component class the reference never gives a token, so this is derived rather than
         transcribed — Bg, because a dialog dims the page towards the ground it already sits on
         rather than towards black. -->
    <Color x:Key="Scrim">#B30B1914</Color>
    <Color x:Key="Surface">#1A2521</Color>
    <!-- oklch(0.252 0.018 170) -->
    <Color x:Key="TextColor">#E4E9E7</Color>
    <!-- oklch(0.930 0.006 170) -->

    <!-- color-mix(in srgb, text 16%, transparent). MAUI hex is #AARRGGBB, so the mix against a
         transparent ground is expressed as the text colour at 16% alpha (0x29). Every other
         color-mix in the source is handled the same way. -->
    <Color x:Key="Divider">#29E4E9E7</Color>

    <!-- Deck / stat-band ground only, per the source: a saturated presence, not an interface
         colour. Do not reach for it as a surface. -->
    <Color x:Key="Section">#054328</Color>
    <!-- oklch(0.34 0.0765 158) -->

    <!-- ══ Accent ramp, hue 158 ══ -->
    <Color x:Key="Accent100">#D7F3E2</Color>
    <!-- oklch(0.94  0.038  158) -->
    <Color x:Key="Accent200">#C4E0CE</Color>
    <!-- oklch(0.88  0.038  158) -->
    <Color x:Key="Accent300">#8ECFA9</Color>
    <!-- oklch(0.80  0.085  158) -->
    <Color x:Key="Accent400">#7CBB96</Color>
    <!-- oklch(0.74  0.085  158) -->
    <Color x:Key="Accent500">#68A783</Color>
    <!-- oklch(0.675 0.085  158) -->
    <Color x:Key="Accent600">#51906D</Color>
    <!-- oklch(0.60  0.085  158) -->
    <Color x:Key="Accent700">#337250</Color>
    <!-- oklch(0.50  0.085  158) -->
    <Color x:Key="Accent800">#054E2F</Color>
    <!-- oklch(0.375 0.085  158) -->
    <Color x:Key="Accent900">#022E1A</Color>
    <!-- oklch(0.265 0.0595 158) -->

    <!-- The one accent voice, identical to Accent500. The source is a mono scheme: its
         accent-2 token resolves to the same value, so no second hue is defined here either. -->
    <Color x:Key="Accent">#68A783</Color>

    <!-- Accent at partial alpha, for the tint fills the component layer asks for: an active nav
         item is a 14% wash, a pressed primary button 22%, a hover 12%. -->
    <Color x:Key="AccentTint10">#1A68A783</Color>
    <Color x:Key="AccentTint14">#2468A783</Color>
    <Color x:Key="AccentTint16">#2968A783</Color>
    <Color x:Key="AccentTint22">#3868A783</Color>
    <Color x:Key="AccentTint30">#4D68A783</Color>
    <Color x:Key="AccentTint34">#5768A783</Color>

    <!-- The accent at zero alpha, which is not the same thing as Transparent. A gradient stop of
         Transparent is #00000000, so a brush running from a tinted accent to Transparent interpolates
         its *hue* toward black on the way and leaves a dirty grey band across the fade. Ending on the
         same colour at zero alpha fades the alpha alone. -->
    <Color x:Key="AccentFade">#0068A783</Color>

    <!-- ══ Neutral ramp, hue 170 ══ -->
    <Color x:Key="Neutral100">#EEF3F1</Color>
    <!-- oklch(0.960 0.006 170) -->
    <Color x:Key="Neutral200">#DCE3E0</Color>
    <!-- oklch(0.910 0.008 170) -->
    <Color x:Key="Neutral300">#C8D0CD</Color>
    <!-- oklch(0.850 0.010 170) -->
    <Color x:Key="Neutral400">#AAB4B0</Color>
    <!-- oklch(0.760 0.012 170) -->
    <Color x:Key="Neutral500">#8A9591</Color>
    <!-- oklch(0.660 0.014 170) -->
    <Color x:Key="Neutral600">#6A7470</Color>
    <!-- oklch(0.550 0.014 170) -->
    <Color x:Key="Neutral700">#4E5854</Color>
    <!-- oklch(0.450 0.014 170) -->
    <Color x:Key="Neutral800">#333D39</Color>
    <!-- oklch(0.350 0.016 170) -->
    <Color x:Key="Neutral900">#1E2925</Color>
    <!-- oklch(0.268 0.016 170) -->

    <!-- Text at reduced alpha. The source expresses muted text as a color-mix against transparent
         at 70% (form labels), 60% (table headers), 55% (.text-muted) and 50% (card meta). -->
    <Color x:Key="TextMuted70">#B3E4E9E7</Color>
    <Color x:Key="TextMuted60">#99E4E9E7</Color>
    <Color x:Key="TextMuted55">#8CE4E9E7</Color>
    <Color x:Key="TextMuted50">#80E4E9E7</Color>

    <!-- The subtle text washes used for hover and row striping: 8%, 7%, 6%, 4%. -->
    <Color x:Key="TextWash8">#14E4E9E7</Color>
    <Color x:Key="TextWash7">#12E4E9E7</Color>
    <Color x:Key="TextWash6">#0FE4E9E7</Color>
    <Color x:Key="TextWash4">#0AE4E9E7</Color>

    <!-- ══ Brushes ══
         Only the tokens something actually paints with need one; a Color cannot be assigned to a
         Brush property, and an unused SolidColorBrush per token is dead weight. -->
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource Bg}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource Divider}" />
    <SolidColorBrush x:Key="SectionBrush" Color="{StaticResource Section}" />
    <SolidColorBrush x:Key="Neutral700Brush" Color="{StaticResource Neutral700}" />
    <SolidColorBrush x:Key="Neutral800Brush" Color="{StaticResource Neutral800}" />
    <SolidColorBrush x:Key="Neutral900Brush" Color="{StaticResource Neutral900}" />
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />
</ResourceDictionary>
