<!-- The gate, transcribed from the source's auth block. Two bodies inside one frame: the sign-in
     form, and the "no access" state for an account GoTrue accepted and the household did not (a
     403 from /api/users/me, which is a different thing from a failed sign-in and says so). -->
<ContentPage
    x:Class="MobileApp.Features.Auth.AuthPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:auth="clr-namespace:MobileApp.Features.Auth"
    xmlns:icons="clr-namespace:MobileApp.Features.Shared"
    xmlns:loc="clr-namespace:MobileApp.Localization"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">

    <auth:AuthScaffold
        Blurb="{Binding Blurb}"
        Kicker="{Binding Kicker}"
        Title="{Binding Title}">

        <Grid>

            <!-- ══ No access ══ -->
            <VerticalStackLayout IsVisible="{Binding IsRejected}" Spacing="16.8">

                <Border Style="{StaticResource Callout}">
                    <VerticalStackLayout Spacing="5.6">
                        <Label
                            CharacterSpacing="1.05"
                            FontSize="{StaticResource FontSizeMeta}"
                            Text="{loc:Localize SignedInAs}"
                            TextColor="{StaticResource Neutral500}"
                            TextTransform="Uppercase" />
                        <Label Style="{StaticResource CalloutText}" Text="{Binding RejectedEmail}" />
                    </VerticalStackLayout>
                </Border>

                <Button Command="{Binding SignOutCommand}" Text="{loc:Localize SignOutOther}" />
            </VerticalStackLayout>

            <!-- ══ Sign in / sign up ══ -->
            <VerticalStackLayout IsVisible="{Binding IsGate}" Spacing="16.8">

                <!-- The segmented control from the source. RadioButtons in a group, so exactly one
                     is on and the platform announces it as a choice. -->
                <Border Style="{StaticResource Seg}">
                    <Grid ColumnDefinitions="*,Auto,*">
                        <RadioButton
                            Content="{loc:Localize SignIn}"
                            GroupName="AuthMode"
                            IsChecked="{Binding IsSignIn}"
                            Style="{StaticResource SegOption}" />

                        <BoxView Grid.Column="1" Style="{StaticResource SegDivider}" />

                        <RadioButton
                            Grid.Column="2"
                            Content="{loc:Localize SignUp}"
                            GroupName="AuthMode"
                            IsChecked="{Binding IsSignUp}"
                            Style="{StaticResource SegOption}" />
                    </Grid>
                </Border>

                <VerticalStackLayout>
                    <Label Style="{StaticResource FieldLabel}" Text="{loc:Localize Email}" />
                    <Entry
                        Keyboard="Email"
                        IsSpellCheckEnabled="False"
                        IsTextPredictionEnabled="False"
                        Placeholder="{loc:Localize EmailPlaceholder}"
                        Text="{Binding Email}" />
                </VerticalStackLayout>

                <VerticalStackLayout>
                    <Label Style="{StaticResource FieldLabel}" Text="{loc:Localize Password}" />
                    <Entry
                        IsPassword="True"
                        Placeholder="{loc:Localize PasswordHint}"
                        ReturnCommand="{Binding SubmitCommand}"
                        ReturnType="Go"
                        Text="{Binding Password}" />
                </VerticalStackLayout>

                <Border IsVisible="{Binding Error, Converter={StaticResource IsPresent}}" Style="{StaticResource Callout}">
                    <Label Style="{StaticResource CalloutText}" Text="{Binding Error}" />
                </Border>

                <Grid MinimumHeightRequest="42">
                    <Button
                        Command="{Binding SubmitCommand}"
                        IsVisible="{Binding IsIdle}"
                        MinimumHeightRequest="42"
                        Style="{StaticResource ButtonPrimary}"
                        Text="{Binding SubmitLabel}" />

                    <ActivityIndicator
                        HeightRequest="20"
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        WidthRequest="20" />
                </Grid>

                <!-- The password rule when signing up, otherwise how to get access at all. -->
                <Label
                    Style="{StaticResource SmallText}"
                    Text="{Binding Footnote}"
                    TextColor="{StaticResource TextMuted55}" />
            </VerticalStackLayout>

        </Grid>
    </auth:AuthScaffold>
</ContentPage>
