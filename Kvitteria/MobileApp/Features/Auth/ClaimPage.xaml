<!-- Shown when the server's readiness report says no active admin exists yet. It calls nothing:
     the household is claimed by the first authenticated request, which is the one the sign-up on
     the next screen will make. This screen exists so that happens on purpose. -->
<ContentPage
    x:Class="MobileApp.Features.Auth.ClaimPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:auth="clr-namespace:MobileApp.Features.Auth"
    xmlns:loc="clr-namespace:MobileApp.Localization"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">

    <auth:AuthScaffold
        Blurb="{loc:Localize ClaimBlurb}"
        Kicker="{loc:Localize ClaimKicker}"
        Title="{loc:Localize ClaimTitle}">

        <VerticalStackLayout Spacing="16.8">

            <Border Style="{StaticResource Note}">
                <Label Style="{StaticResource SmallText}" Text="{loc:Localize ClaimDetail}" />
            </Border>

            <Button
                Command="{Binding ContinueCommand}"
                Style="{StaticResource ButtonPrimary}"
                Text="{loc:Localize ClaimContinue}" />
        </VerticalStackLayout>
    </auth:AuthScaffold>
</ContentPage>
