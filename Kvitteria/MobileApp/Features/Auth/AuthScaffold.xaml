<!-- The frame every screen in this feature wears: an accent kicker with a short rule beside it, a
     title, a blurb, and then whatever that screen is actually for. Taken from the source's auth
     block, which draws exactly this and swaps only the body underneath.

     A ControlTemplate rather than four copies of the same markup: the "no access" state is the same
     frame with a different body, and duplicating it is how the two drift apart. -->
<ContentView
    x:Class="MobileApp.Features.Auth.AuthScaffold"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <ContentView.ControlTemplate>
        <ControlTemplate>
            <ScrollView Padding="18,16,18,40">
                <!-- 400px wide at most, centred. The source caps the auth column at the same width;
                     on a phone the cap never binds and the layout is simply the padding. -->
                <VerticalStackLayout
                    HorizontalOptions="Center"
                    MaximumWidthRequest="400"
                    Spacing="20">

                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                            <Label Style="{StaticResource Eyebrow}" Text="{TemplateBinding Kicker}" VerticalOptions="Center" />
                            <!-- The 26px rule after the kicker. Half-opacity accent, per the source. -->
                            <BoxView
                                BackgroundColor="{StaticResource Accent}"
                                HeightRequest="1"
                                Opacity="0.5"
                                VerticalOptions="Center"
                                WidthRequest="26" />
                        </HorizontalStackLayout>

                        <Label
                            CharacterSpacing="-0.75"
                            Style="{StaticResource H3}"
                            Text="{TemplateBinding Title}" />

                        <Label Style="{StaticResource MutedText}" Text="{TemplateBinding Blurb}" />
                    </VerticalStackLayout>

                    <ContentPresenter />
                </VerticalStackLayout>
            </ScrollView>
        </ControlTemplate>
    </ContentView.ControlTemplate>

</ContentView>
