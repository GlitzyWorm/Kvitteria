<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MobileApp.Features.Overview.SettingsPage"
             x:Name="Page"
             xmlns:loc="clr-namespace:MobileApp.Localization"
             xmlns:tabs="http://sharpnado.com"
             xmlns:settingViews="using:MobileApp.Features.Overview.SettingViews"
             Shell.TabBarIsVisible="False">

    <VerticalStackLayout Padding="{StaticResource PaddingPanel}" Spacing="16.8">

        <!-- <Label Style="{StaticResource Eyebrow}" Text="{loc:Localize Account}"/> -->

        <tabs:TabHostView BackgroundColor="Transparent"
                          HeightRequest="44"
                          IsSegmented="True"
                          SegmentedHasSeparator="True"
                          SegmentedOutlineColor="{StaticResource Divider}"
                          CornerRadius="{StaticResource RadiusMdValue}"
                          SelectedIndex="{Binding SelectedViewModelIndex, Mode=TwoWay, Source={x:Reference Page}}">
            <tabs:SegmentedTabItem Style="{StaticResource SegmentedTab}" Label="{loc:Localize Account}"/>
            <tabs:SegmentedTabItem Style="{StaticResource SegmentedTab}" Label="{loc:Localize InboxKicker}"/>
        </tabs:TabHostView>

        <tabs:ViewSwitcher
            SelectedIndex="{Binding SelectedViewModelIndex, Mode=TwoWay, Source={x:Reference Page}}">

            <settingViews:AccountTab BindingContext="{Binding CurrentViewModel, Source={x:Reference Page}}" />
            <settingViews:InboxTab BindingContext="{Binding CurrentViewModel, Source={x:Reference Page}}" />

        </tabs:ViewSwitcher>

    </VerticalStackLayout>

</ContentPage>