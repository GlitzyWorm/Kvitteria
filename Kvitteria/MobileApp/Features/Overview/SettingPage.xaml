<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MobileApp.Features.Overview.SettingPage"
             x:Name="Page"
             xmlns:loc="clr-namespace:MobileApp.Localization"
             xmlns:tabs="http://sharpnado.com"
             xmlns:views="clr-namespace:MobileApp.Features.Overview.SettingsPages"
             Shell.TabBarIsVisible="False">

    <VerticalStackLayout Padding="{StaticResource PaddingPanel}" Spacing="16.8">

        <!-- <Label Style="{StaticResource Eyebrow}" Text="{loc:Localize Account}"/> -->

        <tabs:TabHostView BackgroundColor="Transparent"
                          HeightRequest="44"
                          IsSegmented="True"
                          SegmentedHasSeparator="True"
                          SegmentedOutlineColor="{StaticResource Divider}"
                          CornerRadius="{StaticResource RadiusMdValue}"
                          SelectedIndex="{Binding SelectedViewModelIndex, Mode=TwoWay, Source={x:Reference Page}}">
            <tabs:SegmentedTabItem Style="{StaticResource SegmentedTab}" Label="{loc:Localize Account}"/>
            <tabs:SegmentedTabItem Style="{StaticResource SegmentedTab}" Label="{loc:Localize ServerKicker}"/>
        </tabs:TabHostView>

        <tabs:ViewSwitcher
            SelectedIndex="{Binding SelectedViewModelIndex, Mode=TwoWay, Source={x:Reference Page}}">

            <views:AccountTab BindingContext="{Binding CurrentViewModel, Source={x:Reference Page}}" />
            <views:AccountTab BindingContext="{Binding CurrentViewModel, Source={x:Reference Page}}" />

        </tabs:ViewSwitcher>

    </VerticalStackLayout>

</ContentPage>