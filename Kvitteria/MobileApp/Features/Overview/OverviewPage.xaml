<!-- Still a scaffold apart from the profile bar, which the source draws above the overview on a
     phone and nowhere else: a greeting, who you are signed in as, and one control top-right. That
     control is where signing out lives — the mockup files it under a Settings screen this app does
     not have yet. -->
<ContentPage
    x:Class="MobileApp.Features.Overview.OverviewPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:icons="clr-namespace:MobileApp.Features.Shared"
    xmlns:vm="clr-namespace:MobileApp.Features.Overview"
    x:DataType="vm:OverviewViewModel">

    <Grid Padding="14,12,14,6" RowDefinitions="Auto,*">

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="11">
            <VerticalStackLayout Spacing="2.8" VerticalOptions="Center">
                <Label
                    CharacterSpacing="-0.38"
                    FontFamily="{StaticResource FontHeading}"
                    FontSize="19"
                    Text="{Binding Greeting}" />
                <Label
                    LineBreakMode="TailTruncation"
                    Style="{StaticResource SmallText}"
                    Text="{Binding SubLine}"
                    TextColor="{StaticResource TextMuted55}" />
            </VerticalStackLayout>

            <Button
                x:Name="AccountButton"
                Grid.Column="1"
                Clicked="OnAccountClicked"
                FontFamily="{StaticResource FontIcons}"
                FontSize="{StaticResource FontSizeIcon}"
                SemanticProperties.Description="{Binding SubLine}"
                Style="{StaticResource ButtonIcon}"
                Text="{x:Static icons:PhosphorIcons.Gear}"
                TextColor="{StaticResource Neutral400}" />
        </Grid>

    </Grid>
</ContentPage>
