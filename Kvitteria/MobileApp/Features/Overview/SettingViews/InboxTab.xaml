<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:MobileApp.Localization"
             xmlns:icons="clr-namespace:MobileApp.Features.Shared"
             xmlns:vm="clr-namespace:MobileApp.Features.Overview.SettingViews"
             x:Class="MobileApp.Features.Overview.SettingViews.InboxTab"
             x:DataType="vm:InboxTabViewModel">

    <VerticalStackLayout Spacing="{StaticResource Space6}">

        <!-- A whole-tab failure: the list could not be loaded, so there is nothing below to act on. -->
        <Border Style="{StaticResource Callout}"
                IsVisible="{Binding Error, Converter={StaticResource IsPresent}}">
            <VerticalStackLayout Spacing="{StaticResource Space2}">
                <Label Style="{StaticResource CalloutText}"
                       LineBreakMode="WordWrap"
                       Text="{Binding Error}" />
                <Button Command="{Binding ReloadCommand}"
                        ContentLayout="Left,8"
                        HorizontalOptions="Start"
                        IsEnabled="{Binding IsIdle}"
                        Text="{loc:Localize Retry}">
                    <Button.ImageSource>
                        <FontImageSource Color="{StaticResource TextColor}"
                                         FontFamily="{StaticResource FontIcons}"
                                         Glyph="{x:Static icons:PhosphorIcons.ArrowClockwise}"
                                         Size="{StaticResource FontSizeIconSm}" />
                    </Button.ImageSource>
                </Button>
            </VerticalStackLayout>
        </Border>

        <ActivityIndicator IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center" />

        <!-- ══ Din indbakke ══ -->
        <VerticalStackLayout Spacing="{StaticResource Space2}">

            <Label Style="{StaticResource BodyText}" Text="{loc:Localize MyMailbox}" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding MyMailboxes}"
                                 IsVisible="{Binding HasMyMailbox}"
                                 Spacing="{StaticResource Space2}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:MailboxRowViewModel">
                        <vm:MailboxCard />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- The empty state doubles as the call to action, as the source has it. -->
            <Border Style="{StaticResource Panel}" IsVisible="{Binding HasNoMyMailbox}">
                <VerticalStackLayout Spacing="{StaticResource Space3}">
                    <Label Style="{StaticResource MutedText}"
                           LineBreakMode="WordWrap"
                           Text="{loc:Localize NoMailboxYet}" />
                    <Button Command="{Binding AddMineCommand}"
                            ContentLayout="Left,8"
                            HeightRequest="{StaticResource ControlHeightSm}"
                            HorizontalOptions="Start"
                            IsEnabled="{Binding IsIdle}"
                            IsVisible="{Binding CanManage}"
                            MinimumHeightRequest="{StaticResource ControlHeightSm}"
                            Style="{StaticResource ButtonPrimary}"
                            Text="{loc:Localize AddMyMailbox}">
                        <Button.ImageSource>
                            <FontImageSource Color="{StaticResource Accent}"
                                             FontFamily="{StaticResource FontIcons}"
                                             Glyph="{x:Static icons:PhosphorIcons.Plus}"
                                             Size="{StaticResource FontSizeIconSm}" />
                        </Button.ImageSource>
                    </Button>
                </VerticalStackLayout>
            </Border>

            <!-- Still offered once I have one: a member may keep more than one folder, and the server's
                 uniqueness is per folder rather than per member. -->
            <Button Command="{Binding AddMineCommand}"
                    ContentLayout="Left,8"
                    HeightRequest="{StaticResource ControlHeightSm}"
                    HorizontalOptions="Start"
                    IsEnabled="{Binding IsIdle}"
                    IsVisible="{Binding CanAddAnotherOfMine}"
                    MinimumHeightRequest="{StaticResource ControlHeightSm}"
                    Text="{loc:Localize AddMyMailbox}">
                <Button.ImageSource>
                    <FontImageSource Color="{StaticResource TextColor}"
                                     FontFamily="{StaticResource FontIcons}"
                                     Glyph="{x:Static icons:PhosphorIcons.Plus}"
                                     Size="{StaticResource FontSizeIconSm}" />
                </Button.ImageSource>
            </Button>

        </VerticalStackLayout>

        <BoxView Style="{StaticResource HorizontalRule}" />

        <!-- ══ Husstandens indbakker ══ -->
        <VerticalStackLayout Spacing="{StaticResource Space2}">

            <Grid ColumnDefinitions="*,Auto">
                <Label Style="{StaticResource BodyText}"
                       Text="{loc:Localize HouseholdMailboxes}"
                       VerticalOptions="Center" />

                <Button Grid.Column="1"
                        Command="{Binding AddOtherCommand}"
                        ContentLayout="Left,8"
                        HeightRequest="{StaticResource ControlHeightSm}"
                        IsEnabled="{Binding IsIdle}"
                        IsVisible="{Binding CanManage}"
                        MinimumHeightRequest="{StaticResource ControlHeightSm}"
                        Text="{loc:Localize AddMailbox}">
                    <Button.ImageSource>
                        <FontImageSource Color="{StaticResource TextColor}"
                                         FontFamily="{StaticResource FontIcons}"
                                         Glyph="{x:Static icons:PhosphorIcons.Plus}"
                                         Size="{StaticResource FontSizeIconSm}" />
                    </Button.ImageSource>
                </Button>
            </Grid>

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding HouseholdMailboxes}"
                                 Spacing="{StaticResource Space2}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:MailboxRowViewModel">
                        <vm:MemberMailboxCard />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Label Style="{StaticResource MutedText}"
                   IsVisible="{Binding HasNoHouseholdMailboxes}"
                   LineBreakMode="WordWrap"
                   Text="{loc:Localize NoOtherMailboxes}" />

        </VerticalStackLayout>

        <!-- Why every control above is missing, for a member without the permission. -->
        <Border Style="{StaticResource Note}" IsVisible="{Binding IsReadOnly}">
            <Label Style="{StaticResource MutedText}"
                   LineBreakMode="WordWrap"
                   Text="{loc:Localize MailboxesReadOnly}" />
        </Border>

    </VerticalStackLayout>

</ContentView>
