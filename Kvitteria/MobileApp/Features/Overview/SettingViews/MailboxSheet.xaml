<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:loc="clr-namespace:MobileApp.Localization"
               xmlns:icons="clr-namespace:MobileApp.Features.Shared"
               xmlns:vm="clr-namespace:MobileApp.Features.Overview.SettingViews"
               x:Class="MobileApp.Features.Overview.SettingViews.MailboxSheet"
               x:TypeArguments="vm:MailboxSheetResult"
               x:DataType="vm:MailboxSheetViewModel"
               BackgroundColor="Transparent"
               Margin="{StaticResource Space8}"
               Padding="0"
               HorizontalOptions="Fill"
               VerticalOptions="Center">

    <!-- MaximumWidthRequest without a WidthRequest, deliberately. A WidthRequest is honoured even when
         it exceeds what the popup was offered, so 430 on a 410pt phone overflowed the margin and the
         sheet went edge to edge; as a maximum it caps a tablet and yields on a phone. The margin is
         what keeps the scrim visible around it, and it is on the Popup rather than on this Border so
         the dismiss-by-tapping-outside area matches what the eye reads as outside.

         Fill rather than Center on both, and that is the pair that matters: Center would make the
         popup shrink-wrap what the fields happen to ask for, which on a form of seven short Entries
         is a dialog much narrower than the screen it is covering. -->
    <Border Style="{StaticResource DialogSurface}"
            MaximumWidthRequest="430"
            HorizontalOptions="Fill"
            VerticalOptions="Center">

        <!-- The field stack scrolls: with a keyboard up, seven fields do not fit a phone. -->
        <ScrollView Orientation="Vertical" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="{StaticResource Space3}">

                <Label Style="{StaticResource H5}" Text="{Binding Title}" />

                <!-- Tilhører -->
                <VerticalStackLayout Spacing="{StaticResource Space1}">
                    <Label Style="{StaticResource FieldLabel}" Text="{loc:Localize BelongsTo}" />
                    <Picker ItemsSource="{Binding Members}"
                            SelectedItem="{Binding Owner}"
                            IsEnabled="{Binding OwnerLocked, Converter={StaticResource IsFalse}}" />
                </VerticalStackLayout>

                <!-- Vært and Port share a row, as the source does: the port is a narrow fixed field. -->
                <Grid ColumnDefinitions="*,88" ColumnSpacing="{StaticResource Space3}">
                    <VerticalStackLayout Spacing="{StaticResource Space1}">
                        <Label Style="{StaticResource FieldLabel}" Text="{loc:Localize Host}" />
                        <Entry Text="{Binding Host}"
                               Keyboard="Url"
                               Placeholder="imap.gmail.com" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="{StaticResource Space1}">
                        <Label Style="{StaticResource FieldLabel}" Text="{loc:Localize Port}" />
                        <Entry Text="{Binding Port}" Keyboard="Numeric" />
                    </VerticalStackLayout>
                </Grid>

                <HorizontalStackLayout Spacing="{StaticResource Space2}">
                    <CheckBox IsChecked="{Binding UseSsl}" VerticalOptions="Center" />
                    <Label Style="{StaticResource BodyText}"
                           Text="{loc:Localize TlsLabel}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>

                <!-- Mappe -->
                <VerticalStackLayout Spacing="{StaticResource Space1}">
                    <Label Style="{StaticResource FieldLabel}" Text="{loc:Localize Folder}" />
                    <Entry Text="{Binding Folder}" Placeholder="INBOX/Kvitteringer" />
                </VerticalStackLayout>

                <!-- Brugernavn -->
                <VerticalStackLayout Spacing="{StaticResource Space1}">
                    <Label Style="{StaticResource FieldLabel}" Text="{loc:Localize Username}" />
                    <Entry Text="{Binding Username}"
                           Keyboard="Email"
                           Placeholder="navn@eksempel.dk" />
                </VerticalStackLayout>

                <!-- Adgangskode. Never prefilled, because the server never returns it. -->
                <VerticalStackLayout Spacing="{StaticResource Space1}">
                    <Label Style="{StaticResource FieldLabel}" Text="{loc:Localize Password}" />
                    <Entry Text="{Binding Password}" IsPassword="True" />
                    <Label Style="{StaticResource MutedText}"
                           Text="{loc:Localize PasswordHintEdit}"
                           IsVisible="{Binding IsEdit}" />
                </VerticalStackLayout>

                <HorizontalStackLayout Spacing="{StaticResource Space2}">
                    <CheckBox IsChecked="{Binding IsEnabled}" VerticalOptions="Center" />
                    <Label Style="{StaticResource BodyText}"
                           Text="{loc:Localize EnabledLabel}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>

                <!-- Whatever the server or the validator said. Wraps: an IMAP failure can name every
                     folder that does exist, and truncating that would waste the useful half. -->
                <Border Style="{StaticResource Callout}"
                        IsVisible="{Binding Error, Converter={StaticResource IsPresent}}">
                    <Label Style="{StaticResource CalloutText}"
                           LineBreakMode="WordWrap"
                           Text="{Binding Error}" />
                </Border>

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   HorizontalOptions="Center" />

                <!-- Fjern sits apart on the left, as the source places it: destructive, and not the
                     thing the eye should land on next to Gem. -->
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{StaticResource Space2}">
                    <Button Command="{Binding RemoveCommand}"
                            ContentLayout="Left,8"
                            IsEnabled="{Binding IsIdle}"
                            IsVisible="{Binding IsEdit}"
                            Style="{StaticResource ButtonGhost}"
                            Text="{loc:Localize Remove}">
                        <Button.ImageSource>
                            <FontImageSource Color="{StaticResource TextMuted70}"
                                             FontFamily="{StaticResource FontIcons}"
                                             Glyph="{x:Static icons:PhosphorIcons.Trash}"
                                             Size="{StaticResource FontSizeIconSm}" />
                        </Button.ImageSource>
                    </Button>

                    <Button Grid.Column="2"
                            Command="{Binding CancelCommand}"
                            IsEnabled="{Binding IsIdle}"
                            Style="{StaticResource ButtonGhost}"
                            Text="{loc:Localize Cancel}" />

                    <Button Grid.Column="3"
                            Command="{Binding SaveCommand}"
                            IsEnabled="{Binding IsIdle}"
                            Style="{StaticResource ButtonPrimary}"
                            Text="{loc:Localize Save}" />
                </Grid>

            </VerticalStackLayout>
        </ScrollView>
    </Border>

</toolkit:Popup>
