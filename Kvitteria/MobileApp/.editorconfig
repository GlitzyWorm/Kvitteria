# Scoped to this project on purpose. MPL-2.0's copyleft is per file and attaches through the Exhibit A
# notice, so a source file here without that header is not clearly covered — the header is the
# mechanism, not decoration. IDE0073 makes a new file fail the build instead of quietly missing it.
#
# No `root = true`: if a repo-wide .editorconfig is ever added, this subtree should still inherit its
# conventions and only add the header rule on top. Neither Backend nor Contracts is affected, since
# both are AGPL and MIT respectively and need no per-file notice.

[*.cs]
file_header_template = This Source Code Form is subject to the terms of the Mozilla Public\nLicense, v. 2.0. If a copy of the MPL was not distributed with this\nfile, You can obtain one at https://mozilla.org/MPL/2.0/.
dotnet_diagnostic.IDE0073.severity = error
