<!-- The template's counter page is gone. Until there is a backend call to make, this page's job is
     to exercise the design system on a real device: every token that the styles expose appears here
     at least once, so a font that failed to load or a colour that resolved wrong is visible at a
     glance rather than discovered on the first real screen. The copy is Danish, matching the app. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MobileApp.MainPage"
             Title="Oversigt">

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PaddingPanel}" Spacing="{StaticResource Space6}">

            <VerticalStackLayout Spacing="{StaticResource Space2}">
                <Label Text="Husstand" Style="{StaticResource Eyebrow}" />
                <Label Text="Husstandens forbrug" Style="{StaticResource H3}" />
                <Label Text="Denne måned, på tværs af alle husstandens kvitteringer."
                       Style="{StaticResource MutedText}" />
            </VerticalStackLayout>

            <!-- The gradient hero. The Grid is the whole trick: its three children occupy the same
                 cell, so they stack — wash, corner glow, then content — and the Border around them
                 clips all of it to the rounded corner. -->
            <Border Style="{StaticResource HeroCard}">
                <Grid>
                    <Border Style="{StaticResource HeroWashLayer}" />
                    <Border Style="{StaticResource HeroCornerGlowLayer}" />

                    <VerticalStackLayout Spacing="{StaticResource Space1}">
                        <Label Text="August 2026" Style="{StaticResource Eyebrow}" />
                        <Label Text="2.438,27 kr" Style="{StaticResource KvNumHero}"
                               Margin="0,2.8,0,8.4" />
                        <HorizontalStackLayout Spacing="{StaticResource Space2}">
                            <Border Style="{StaticResource TagAccent}">
                                <Label Text="+5,8 %" Style="{StaticResource TagText}" />
                            </Border>
                            <Label Text="ift. sidste måned · 14 kvitteringer"
                                   Style="{StaticResource SmallText}"
                                   TextColor="{StaticResource Neutral400}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border Style="{StaticResource Panel}">
                <VerticalStackLayout Spacing="{StaticResource Space4}">

                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="{StaticResource Space2}">
                            <Label Text="Denne måned" Style="{StaticResource CardKicker}" />
                            <Label Text="Dagligvarer" Style="{StaticResource CardTitle}" />
                            <Label Text="736,87 kr på tværs af 14 kvitteringer, +5,8 % ift. sidste måned."
                                   Style="{StaticResource CardBody}" />
                            <Label Text="+5,8 %" Style="{StaticResource CardMeta}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource Card}" Stroke="{StaticResource Neutral700}"
                            Shadow="{StaticResource ElevationMd}">
                        <VerticalStackLayout Spacing="{StaticResource Space2}">
                            <Label Text="Pipeline" Style="{StaticResource CardKicker}" />
                            <Label Text="Udtrækning i kø" Style="{StaticResource CardTitle}" />
                            <Label Text="2 kvitteringer venter, forsøg 2 af 3."
                                   Style="{StaticResource CardBody}" />
                        </VerticalStackLayout>
                    </Border>

                    <BoxView Style="{StaticResource HorizontalRule}" />

                    <!-- Tags are a Border plus a Label: MAUI has no control that carries a fill, a
                         radius and text at once. -->
                    <HorizontalStackLayout Spacing="{StaticResource Space2}">
                        <Border Style="{StaticResource TagAccent}">
                            <Label Text="Dagligvarer" Style="{StaticResource TagText}" />
                        </Border>
                        <Border Style="{StaticResource TagNeutral}">
                            <Label Text="Udtrukket" Style="{StaticResource TagTextNeutral}" />
                        </Border>
                        <Border Style="{StaticResource TagOutline}">
                            <Label Text="Afventer" Style="{StaticResource TagTextOutline}" />
                        </Border>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="{StaticResource Space2}">
                        <Button Text="Gem ændringer" Style="{StaticResource ButtonPrimary}" />
                        <Button Text="Annullér" />
                    </HorizontalStackLayout>

                    <Button Text="Ryd filter" Style="{StaticResource ButtonGhost}"
                            HorizontalOptions="Start" />

                    <VerticalStackLayout>
                        <Label Text="E-mail" Style="{StaticResource FieldLabel}" />
                        <Border>
                            <Entry Placeholder="dig@husstand.dk" Keyboard="Email" />
                        </Border>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
