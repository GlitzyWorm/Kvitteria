<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Android builds on any host, so it is the unconditional entry. The others are added only
		     where their toolchain exists: listing Mac Catalyst unconditionally makes `dotnet build`
		     on the solution fail on Windows and on every Linux runner, which is where the backend's
		     own CI builds.
		     Windows is a *development* target, not a shipping one. On a Windows machine it is much
		     the fastest way to run the app, and it is what the template's only launch profile
		     ("Windows Machine" in Properties/launchSettings.json) selects. Without it Visual Studio
		     offers that profile with no framework behind it and the run fails with 0x80008083, which
		     names nothing.
		     The template also matched Mac Catalyst twice on macOS, since `!linux` and `osx` both
		     applied. iOS is still deliberately absent — add it the same way once there is a Mac. -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(TargetFrameworks);net10.0-maccatalyst</TargetFrameworks>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<!-- Overrides the AGPL-3.0-or-later in ../Directory.Build.props. MPL-2.0 so this can ship
		     through app stores, whose terms conflict with GPLv3 §6 (installation information) and
		     §10 (no further restrictions). MPL's copyleft is per file and attaches through the
		     Exhibit A header, so every source file here carries one — see ./LICENSE and
		     ./.editorconfig. -->
		<PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>

		<!-- So IDE0073 (file header) actually fails the build rather than only showing in an IDE.
		     TreatWarningsAsErrors stays off: the MAUI template warns about unrelated things, and a
		     missing licence header should not be indistinguishable from those. -->
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

		<OutputType>Exe</OutputType>
		<RootNamespace>MobileApp</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>Kvitteria</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>dev.jelshoj.kvitteria</ApplicationId>

		<!-- The version this component reports, and the single source of truth for it. release-please
		     rewrites this line and finds it by the trailing marker comment, so both must stay together
		     on one line — see Backend.csproj, which is versioned the same way. -->
		<ApplicationDisplayVersion>0.0.0</ApplicationDisplayVersion> <!-- x-release-please-version -->

		<!-- Android's versionCode and iOS' CFBundleVersion: a monotonically increasing integer, which
		     a semver string cannot supply. CI passes the run number; this local default only has to
		     be valid, not meaningful. -->
		<ApplicationVersion>1</ApplicationVersion>

		<!-- The MAUI SDK maps ApplicationDisplayVersion onto Version (and hence PackageVersion) for
		     Android/iOS/MacCatalyst, but the Windows packaging targets don't and fall back to the
		     plain SDK default of 1.0.0. NuGet restore requires PackageVersion to agree across every
		     TFM in a multi-targeted project, so left unset this fails restore with NU1105 the moment
		     the Windows TFM is actually evaluated (i.e. on a Windows dev machine) — which then
		     cascades into every reference failing to resolve. Pin it explicitly so it can't diverge. -->
		<Version>$(ApplicationDisplayVersion)</Version>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0B1914" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0B1914" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />

		<!-- Both licence texts ship inside the app package so LicensesPage can display them. MIT
		     requires its notice to accompany the software and app users receive a binary, not this
		     repository. Referenced in place rather than copied into Resources\Raw, so there is only
		     ever one copy of each to keep current. -->
		<MauiAsset Include="LICENSE" LogicalName="licenses/MPL-2.0.txt" />
		<MauiAsset Include="..\Contracts\LICENSE" LogicalName="licenses/MIT.txt" />

		<!-- Montserrat and Poppins ship inside the package as MauiFonts. The SIL Open Font License
		     requires its notice to travel with the font, and it is a different licence per family
		     (different copyright lines), so both texts are here rather than one shared copy. They
		     live in licenses\ and not Resources\Fonts\, because the MauiFont glob above would
		     otherwise try to embed a .txt as a typeface. -->
		<MauiAsset Include="licenses\OFL-Montserrat.txt" LogicalName="licenses/OFL-Montserrat.txt" />
		<MauiAsset Include="licenses\OFL-Poppins.txt" LogicalName="licenses/OFL-Poppins.txt" />

		<!-- Phosphor is MIT rather than OFL, but the obligation is the same shape: the notice has to
		     travel with the binary, and an app user receives a binary rather than this repository. -->
		<MauiAsset Include="licenses\MIT-Phosphor.txt" LogicalName="licenses/MIT-Phosphor.txt" />
	</ItemGroup>

	<ItemGroup>
		<!-- Versions come from ../Directory.Packages.props. The template pins them inline, which
		     central package management rejects with NU1008. -->
		<PackageReference Include="CommunityToolkit.Maui" />
		<PackageReference Include="CommunityToolkit.Mvvm" />
		<PackageReference Include="Microsoft.Maui.Controls" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" />
		<PackageReference Include="Microsoft.Extensions.Http" />
		<PackageReference Include="Sharpnado.Tabs.Maui" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Contracts\Contracts.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Danish is the *neutral* set and English the satellite, which is the opposite of the usual
		     arrangement and is the point: the app is Danish-first, so a device in a language nobody
		     has translated should fall back to Danish rather than to English.

		     Generator is cleared deliberately. ResXFileCodeGenerator is a Visual Studio single-file
		     generator rather than an MSBuild target, so a designer file that is not committed simply
		     does not exist on a CI runner — and mobile.yml builds this project on Ubuntu. Nothing
		     needs generating: strings are read through ILocalizationService's indexer so they can
		     change language at runtime, which generated static properties cannot do. -->
		<EmbeddedResource Update="Localization\AppResources.resx">
			<Generator></Generator>
		</EmbeddedResource>
		<EmbeddedResource Update="Localization\AppResources.en.resx">
			<Generator></Generator>
		</EmbeddedResource>
	</ItemGroup>

	<!-- AndroidManifest.xml references @xml/network_security_config unconditionally, and exactly one
	     of these two files supplies it. Two files rather than one excluded in Release, because a
	     dangling resource reference fails at aapt2 with a message about the manifest rather than
	     about the missing file.

	     Debug permits cleartext so the emulator can reach http://10.0.2.2:8080, where the compose
	     stack has no certificate in front of it. Release forbids it: the server address is typed by
	     the user, and permitting cleartext in a shipped app would let a typo or a hostile network
	     downgrade every request — bearer token included. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<AndroidResource Remove="Platforms\Android\Resources\xml\network_security_config.debug.xml" />
		<AndroidResource Remove="Platforms\Android\Resources\xml\network_security_config.release.xml" />

		<AndroidResource Condition="'$(Configuration)' == 'Debug'" Include="Platforms\Android\Resources\xml\network_security_config.debug.xml" Link="Resources\xml\network_security_config.xml" />

		<AndroidResource Condition="'$(Configuration)' != 'Debug'" Include="Platforms\Android\Resources\xml\network_security_config.release.xml" Link="Resources\xml\network_security_config.xml" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Features\Insights\InsightsPage.xaml.cs">
	    <DependentUpon>InsightsPage.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="Features\Overview\SettingPage.xaml.cs">
	    <DependentUpon>SettingPage.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="Features\Overview\OverviewPage.xaml.cs">
	    <DependentUpon>OverviewPage.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="Features\Overview\SettingViews\AccountTab.xaml.cs">
	    <DependentUpon>AccountTab.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="Features\Pipeline\PipelinePage.xaml.cs">
	    <DependentUpon>PipelinePage.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="Features\Receipts\ReceiptsPage.xaml.cs">
	    <DependentUpon>ReceiptsPage.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="Features\Sort\SortPage.xaml.cs">
	    <DependentUpon>SortPage.xaml</DependentUpon>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <MauiXaml Update="Features\Insights\InsightsPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Features\Overview\SettingPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Features\Overview\SettingViews\AccountTab.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Features\Pipeline\PipelinePage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Features\Receipts\ReceiptsPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Features\Sort\SortPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Features\Overview\OverviewPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	</ItemGroup>

	<ItemGroup>
	  <None Update="Features\Overview\SettingsPages\AccountTab.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </None>
	</ItemGroup>

</Project>
