<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MobileApp"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MobileApp.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Order is load-bearing: Styles.xaml and Tokens.xaml both resolve
                     StaticResource keys that Colors.xaml owns, and a merged dictionary can
                     only see keys merged before it. -->
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Tokens.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters, merged after the dictionaries so a style can never depend on one.
                 IsPresent drives every "show this only when there is something to show" case:
                 an inline form error, a typing hint. The alternative is a bool property beside
                 every string on every view model, which is the same rule written five times. -->
            <toolkit:IsStringNotNullOrEmptyConverter x:Key="IsPresent" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
