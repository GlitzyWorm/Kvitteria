<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MobileApp"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MobileApp.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Order is load-bearing: Styles.xaml and Tokens.xaml both resolve
                     StaticResource keys that Colors.xaml owns, and a merged dictionary can
                     only see keys merged before it. -->
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Tokens.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters, merged after the dictionaries so a style can never depend on one.
                 IsPresent drives every "show this only when there is something to show" case:
                 an inline form error, a typing hint. The alternative is a bool property beside
                 every string on every view model, which is the same rule written five times. -->
            <toolkit:IsStringNotNullOrEmptyConverter x:Key="IsPresent" />

            <!-- IsFalse negates a bool binding — the "show the other tag" half of an active/inactive
                 pair, where only one of two IsVisible bindings can invert the other's condition. -->
            <toolkit:InvertedBoolConverter x:Key="IsFalse" />

            <!-- How every sheet is presented. Declared here rather than built in the dialog service
                 so the scrim stays a token: a colour literal in C# is the one thing the design system
                 forbids.

                 Shape is explicitly null because the sheet paints its own DialogSurface border, so the
                 rounding comes from the component layer like every other surface. Left at its default
                 the toolkit wraps the content in a second, light-stroked 20-radius rectangle of its
                 own — a pale ring around a dark card, on a design system with no light ramp at all.
                 The matching half is BackgroundColor="Transparent" on the Popup itself, whose default
                 is white. -->
            <toolkit:PopupOptions x:Key="SheetPopupOptions"
                                  CanBeDismissedByTappingOutsideOfPopup="True"
                                  PageOverlayColor="{StaticResource Scrim}"
                                  Shape="{x:Null}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
