<ContentPage
    x:Class="MobileApp.LicensesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Licenser">

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PaddingPanel}" Spacing="{StaticResource Space4}">

            <Label Text="Om" Style="{StaticResource Eyebrow}" />
            <Label Text="Kvitteria" Style="{StaticResource H3}" />

            <Label Text="This app is licensed under the Mozilla Public License 2.0. It includes Kvitteria.Contracts, licensed under the MIT License. It bundles the Montserrat and Poppins typefaces under the SIL Open Font License 1.1, and the Phosphor icon font under the MIT License. The Kvitteria backend it talks to is licensed separately, under the GNU Affero General Public License v3." />

            <BoxView Style="{StaticResource HorizontalRule}" />

            <Label Text="Mozilla Public License 2.0 — this app" Style="{StaticResource H6}" />
            <!-- The licence texts keep OpenSans rather than the Kvitteria body face: they are a wall
                 of legal prose nobody reads for pleasure, and a neutral face at a small size is more
                 legible here than Poppins. The size is below the type scale's smallest step for the
                 same reason — this is a verbatim document, not interface copy. -->
            <Label x:Name="MplText" FontFamily="OpenSansRegular" FontSize="11"
                   TextColor="{StaticResource Neutral400}" LineHeight="1.4" />

            <BoxView Style="{StaticResource HorizontalRule}" />

            <Label Text="MIT License — Kvitteria.Contracts" Style="{StaticResource H6}" />
            <Label x:Name="MitText" FontFamily="OpenSansRegular" FontSize="11"
                   TextColor="{StaticResource Neutral400}" LineHeight="1.4" />

            <BoxView Style="{StaticResource HorizontalRule}" />

            <!-- Two separate OFL notices rather than one: the licence is per family and each carries
                 its own copyright line. -->
            <Label Text="SIL Open Font License 1.1 — Montserrat" Style="{StaticResource H6}" />
            <Label x:Name="MontserratOflText" FontFamily="OpenSansRegular" FontSize="11"
                   TextColor="{StaticResource Neutral400}" LineHeight="1.4" />

            <Label Text="SIL Open Font License 1.1 — Poppins" Style="{StaticResource H6}" />
            <Label x:Name="PoppinsOflText" FontFamily="OpenSansRegular" FontSize="11"
                   TextColor="{StaticResource Neutral400}" LineHeight="1.4" />

            <BoxView Style="{StaticResource HorizontalRule}" />

            <!-- Phosphor is MIT rather than OFL, but the obligation is the same: the notice travels
                 with the binary. Listed separately from Contracts' MIT notice because it is a
                 different copyright holder. -->
            <Label Text="MIT License — Phosphor icons" Style="{StaticResource H6}" />
            <Label x:Name="PhosphorMitText" FontFamily="OpenSansRegular" FontSize="11"
                   TextColor="{StaticResource Neutral400}" LineHeight="1.4" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
