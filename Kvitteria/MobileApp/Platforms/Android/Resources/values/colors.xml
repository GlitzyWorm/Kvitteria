<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The native side of the palette: Android paints the window background and status bar from
         these before any MAUI page exists, so leaving them purple showed a flash of the template's
         colour at every cold start. Values mirror Resources/Styles/Colors.xaml: the bg, surface and
         accent tokens. A double hyphen cannot appear in an XML comment, so the CSS custom-property
         names those tokens carry in the design system are spelled out rather than quoted. -->
    <color name="colorPrimary">#0B1914</color>
    <color name="colorPrimaryDark">#1A2521</color>
    <color name="colorAccent">#68A783</color>
</resources>