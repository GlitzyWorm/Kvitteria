<!-- Debug only. The emulator reaches the compose stack at http://10.0.2.2:8080 and there is no
     certificate in front of Caddy, so a development build has to permit cleartext or the very first
     probe fails with an exception that names TLS rather than the missing permission.

     The release counterpart forbids it. Both files exist and MobileApp.csproj includes exactly one
     of them as @xml/network_security_config, so the manifest's reference always resolves — a single
     file excluded in Release would fail the build at aapt2 instead. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
