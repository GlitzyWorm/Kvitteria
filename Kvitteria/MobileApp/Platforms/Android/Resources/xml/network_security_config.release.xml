<!-- A shipped build talks HTTPS or it does not talk. The server address is typed by the user, so
     permitting cleartext here would let a typo, or a hostile network, downgrade every request the
     app makes — including the bearer token on all of them.

     A self-hoster therefore has to put TLS in front of the stack. See docs/configuration.md. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
