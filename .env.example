# -----------------------------------------------------------------------------------------------
# Kvitteria configuration. Copy to `.env` and fill in the generated values, or let the setup script
# do both:  ./scripts/setup.sh   (or  .\scripts\setup.ps1  on Windows)
#
# Compose reads `.env` from the directory holding compose.yaml. `.env` is gitignored; this file is
# not, so keep secrets out of it.
#
# Do not quote values. Compose keeps the quotes as part of the value, and a quoted JWK set or
# connection-string fragment then fails to parse.
# -----------------------------------------------------------------------------------------------

# Prefix for container and volume names. Change it only to run two Kvitteria stacks on one host.
COMPOSE_PROJECT_NAME=kvitteria

# Uncomment to opt into GPU passthrough for Ollama. Setting COMPOSE_FILE disables the automatic
# pickup of compose.override.yaml, so it has to be listed explicitly.
#COMPOSE_FILE=compose.yaml:compose.override.yaml:compose.gpu.yaml


# --- Images -------------------------------------------------------------------------------------

# Published images. Lowercase, because container registries require it even when the account is not.
IMAGE_REGISTRY=ghcr.io/glitzyworm

# Which backend build to run. Pin as tightly as you want to: an exact version (0.1.0), a floating
# minor (0.1), a floating major (0), or latest. Note that 0 is not a stability promise — the project
# is pre-1.0, so a minor bump may break things.
BACKEND_VERSION=latest

GOTRUE_VERSION=v2.177.0
POSTGRES_VERSION=17
CADDY_VERSION=2-alpine
OLLAMA_VERSION=latest


# --- Networking ---------------------------------------------------------------------------------

# The single origin everything is reached through: the API, auth, and eventually the web app. It
# must be the URL *clients* use, because it becomes the token issuer both sides validate against.
PUBLIC_URL=http://localhost:8080

# Host port for the entrypoint above. Change both together.
CADDY_HTTP_PORT=8080


# --- Database -----------------------------------------------------------------------------------

# Not published to the host, so this password never leaves the compose network. The setup script
# generates a random one. Changing it after the first start requires `docker compose down -v`,
# because the volume was initialized with the old value.
POSTGRES_DB=kvitteria
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# --- Identity -----------------------------------------------------------------------------------

# The ES256 signing key set GoTrue signs tokens with: a JSON *array* of JWKs on one line — a
# {"keys": [...]} wrapper is rejected at startup. The setup script generates it. The backend never
# sees this; it fetches the public half from the JWKS endpoint.
GOTRUE_JWT_KEYS=

# GoTrue's configuration loader requires a symmetric secret whether or not asymmetric keys are set,
# and refuses to start without one. With GOTRUE_JWT_KEYS present, tokens are signed with ES256 and
# this goes unused — so it is generated, never shared, and deliberately not given to the backend,
# which rejects a shared secret outside Development precisely so nothing can quietly fall back to it.
GOTRUE_JWT_SECRET=

# Where the app redirects after an email link, and the exact URLs auth is permitted to redirect to.
# Point these at the web app once it exists.
GOTRUE_SITE_URL=http://localhost:8080
GOTRUE_URI_ALLOW_LIST=http://localhost:8080

# Access token lifetime in seconds. Clients refresh; this is not how long a session lasts.
GOTRUE_JWT_EXP=3600

# Members sign themselves up and the backend rejects anyone an admin has not pre-authorized — except
# the very first caller, who claims an empty household as its admin. Close this once that has
# happened if the stack is reachable from anywhere but your own machine.
GOTRUE_DISABLE_SIGNUP=false

# No SMTP is configured anywhere in this project, so an unconfirmed address could never confirm
# itself. Turning autoconfirm off without configuring SMTP first locks everyone out.
GOTRUE_MAILER_AUTOCONFIRM=true

GOTRUE_PASSWORD_MIN_LENGTH=8
GOTRUE_LOG_LEVEL=info


# --- Extraction ---------------------------------------------------------------------------------

# One value, read by two things: the Ollama container pulls this tag, and the backend seeds it into
# its pipeline settings. That is what stops the pipeline asking for a model nobody pulled.
#
# It seeds only. Once the row exists, change the model through PUT /api/settings/pipeline — editing
# this variable will not move it.
OLLAMA_MODEL=qwen3.5:4b

# Extraction on CPU takes minutes per receipt, so this is generous on purpose.
OLLAMA_REQUEST_TIMEOUT_SECONDS=1200


# --- Runtime ------------------------------------------------------------------------------------

# Development additionally serves the OpenAPI document and the Scalar reference at /scalar, and logs
# at Debug. Leave it as Production unless you are working on the backend.
ASPNETCORE_ENVIRONMENT=Production

# Danish receipts are parsed against this zone, including across the spring-forward gap.
TZ=Europe/Copenhagen

# The backend fetches signing keys from GoTrue over the compose network, where there is no
# certificate to present. HTTPS for that fetch is otherwise required, because whoever can answer it
# decides which tokens are valid. Set this to false if you move identity to a host with TLS.
AUTH_ALLOW_INSECURE_JWKS_TRANSPORT=true
