{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",

  "separate-pull-requests": true,
  "include-component-in-tag": true,

  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,

  "//": "History before this commit used a `feature:` type that Conventional Commits does not define, so release-please cannot read it and would produce a misleading first changelog. Anchoring here makes 0.1.0 the release that documents self-hosted packaging, and nothing older.",
  "last-release-sha": "a64da40e8c85ec8dbc6ddab8da383fb6564c8663",

  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "refactor", "section": "Refactoring" },
    { "type": "build", "section": "Build System" },
    { "type": "docs", "section": "Documentation" },
    { "type": "ci", "section": "CI", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "style", "section": "Style", "hidden": true },
    { "type": "chore", "section": "Chores", "hidden": true }
  ],

  "packages": {
    "Kvitteria/Backend": {
      "release-type": "simple",
      "component": "backend",
      "package-name": "kvitteria-backend",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "generic",
          "path": "Backend.csproj"
        }
      ]
    }
  }
}
